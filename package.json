{
  "name": "conta-facil",
  "version": "1.0.0",
  "description": "Conta Fácil: divida a conta do bar sem calculadora. App web instalável (PWA) do Projeto Fácil.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node comum/servidor.mjs",
    "test": "node --test --test-concurrency=1 --test-force-exit comum/testes/kit.test.mjs tests/*.test.mjs",
    "verificar": "node comum/verificar.mjs",
    "testar-regras": "node comum/testar-regras.mjs",
    "test:kit": "node comum/testar.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "@axe-core/playwright": "^4.11.0"
  },
  "engines": {
    "node": ">=22"
  }
}
